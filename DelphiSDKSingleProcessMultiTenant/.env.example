# Copy this file to bin\.env and put your real key in it.
# bin\ is gitignored, so the key cannot reach a commit.

# Your key from https://exewatch.com. One key for the whole application:
# it identifies the app, not the running copy and not the tenant.
exewatch.api.key=ew_win_YOUR_API_KEY_HERE

# Release tag of this deployment: a version, a build number, a commit.
# It is what tells you which release an error came from.
exewatch.app.version=1.0.0
