package ExeWatchMapExpert;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}

{$DESCRIPTION 'ExeWatch map linker - links the .map into the binary at build end'}

{$DESIGNONLY}

requires
  rtl,
  designide;

contains
  EWMapExpert in 'EWMapExpert.pas',
  EWMapSplash in 'EWMapSplash.pas',
  EWMapInjectU in '..\EWMapInjectU.pas';

end.